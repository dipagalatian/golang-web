<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{.Title}}</title>
    </head>
    <body>
        {{if .Name}}
        <h1>Hello {{.Name}}, nice to see you!</h1>
        {{else}}
        <h1>Hello Guest, please provide your name!</h1>
        {{end}}
    </body>
</html>