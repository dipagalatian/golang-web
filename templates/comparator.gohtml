<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{.Title}}</title>
    </head>
    <body>
        {{if ge .FinalValue 80}}
        <h1>Excellent! Your scrore is {{.FinalValue}}</h1>
        {{else if ge .FinalValue 70}}
        <h1>Very Good! Your score is {{.FinalValue}}</h1>
        {{else}}
        <h1>Keep trying, you can do it Your score is {{.FinalValue}}!</h1>
        {{end}}
    </body>
</html>