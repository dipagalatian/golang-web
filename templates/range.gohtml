<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{.Title}}</title>
    </head>
    <body>
        {{range $index, $element := .Hobbies}}
        <h1>Hobby {{$index}}: {{$element}}</h1>
        {{else}}
        <h1>No Hobbies Found</h1>
        {{end}}
    </body>
</html>