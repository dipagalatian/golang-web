<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{{.Title}}</title>
    </head>
    <body>

        {{/* Accessing nested struct data with 'with' action */}}
        
        <h1>Name: {{.Name}}</h1>

        {{with .Address}}
        <h1>Address street: {{.Street}}</h1>
        <h1>Address city: {{.City}}</h1>
        <h1>Address country: {{.Country}}</h1>
        {{else}}
        <h1>No Address Found</h1>
        {{end}}
        
    </body>
</html>